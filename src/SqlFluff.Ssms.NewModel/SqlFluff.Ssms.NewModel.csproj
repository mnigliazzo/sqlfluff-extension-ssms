<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Probe for the pure (out-of-process) VisualStudio.Extensibility model in SSMS 22: an extension
    that runs in its own .NET process, contributes a command, and provides SQLFluff diagnostics
    through a Language Server instead of the in-process VSSDK tagger/Error List/Light Bulb.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SqlFluff.Ssms.NewModel</RootNamespace>
    <AssemblyName>SqlFluff.Ssms.NewModel</AssemblyName>
    <!-- LanguageServerProvider is still a preview API in VisualStudio.Extensibility 17.14; opting in is what this probe tests. -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_LSP</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" />
  </ItemGroup>

  <!-- Same pure, VS-free SQLFluff logic the VSIX uses, linked rather than duplicated. -->
  <ItemGroup>
    <Compile Include="..\SqlFluff.Ssms\Core\SqlFluffRunner.cs" Link="Core\SqlFluffRunner.cs" />
    <Compile Include="..\SqlFluff.Ssms\Core\SqlFluffSettings.cs" Link="Core\SqlFluffSettings.cs" />
    <Compile Include="..\SqlFluff.Ssms\Core\LintViolation.cs" Link="Core\LintViolation.cs" />
    <Compile Include="..\SqlFluff.Ssms\Core\LintJsonParser.cs" Link="Core\LintJsonParser.cs" />
    <Compile Include="..\SqlFluff.Ssms\Core\ArgumentQuoting.cs" Link="Core\ArgumentQuoting.cs" />
    <Compile Include="..\SqlFluff.Ssms\Core\SqlFluffConfigResolver.cs" Link="Core\SqlFluffConfigResolver.cs" />
    <Compile Include="..\SqlFluff.Ssms\Core\SqlFluffWorkingDirectoryResolver.cs" Link="Core\SqlFluffWorkingDirectoryResolver.cs" />
    <Compile Include="..\SqlFluff.Ssms\Core\SqlFluffVersionParser.cs" Link="Core\SqlFluffVersionParser.cs" />
  </ItemGroup>

  <!--
    VisualStudio.Extensibility's ExtensionMetadata can't name the target product: the generated
    manifest always targets Microsoft.VisualStudio.Community. SSMS 22 identifies as
    Microsoft.VisualStudio.Ssms (same as the VSSDK extension's own manifest), so retarget the
    generated manifest before it's packaged. Whether SSMS then hosts the extension is what this
    probe finds out.
  -->
  <Target Name="RetargetGeneratedManifestToSsms" AfterTargets="CoreCompile" Condition="Exists('$(IntermediateOutputPath)extension.vsixmanifest')">
    <PropertyGroup>
      <_SqlFluffManifest>$([System.IO.File]::ReadAllText('$(IntermediateOutputPath)extension.vsixmanifest'))</_SqlFluffManifest>
      <_SqlFluffManifest>$(_SqlFluffManifest.Replace('Id="Microsoft.VisualStudio.Community" Version="[17.14,)"', 'Id="Microsoft.VisualStudio.Ssms" Version="[22.0,)"'))</_SqlFluffManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)extension.vsixmanifest" Lines="$(_SqlFluffManifest)" Overwrite="true" />
  </Target>

</Project>
