<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SqlFluff.Ssms.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    These are pure, VS-SDK-free files from the main project (no net48/VSSDK dependency), compiled
    directly into this net8.0 test project instead of via ProjectReference. A ProjectReference to
    SqlFluff.Ssms.csproj would drag in its VSSDK.BuildTools targets (VSCT compilation, pkgdef
    generation, ...), which need SSMS's or Visual Studio's MSBuild — exactly what `dotnet test`
    should NOT require.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\ArgumentQuoting.cs" Link="Sources\ArgumentQuoting.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\LintJsonParser.cs" Link="Sources\LintJsonParser.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\LintViolation.cs" Link="Sources\LintViolation.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\SqlFluffConfigResolver.cs" Link="Sources\SqlFluffConfigResolver.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\LineDiff.cs" Link="Sources\LineDiff.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\SqlFluffWorkingDirectoryResolver.cs" Link="Sources\SqlFluffWorkingDirectoryResolver.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\NoqaCommentEditor.cs" Link="Sources\NoqaCommentEditor.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\UpdateInfo.cs" Link="Sources\UpdateInfo.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\UpdateInfoParser.cs" Link="Sources\UpdateInfoParser.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\SqlFluffVersionParser.cs" Link="Sources\SqlFluffVersionParser.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\PyPiPackageInfoParser.cs" Link="Sources\PyPiPackageInfoParser.cs" />
    <Compile Include="..\..\src\SqlFluff.Ssms\Core\VersionComparer.cs" Link="Sources\VersionComparer.cs" />
  </ItemGroup>

</Project>
